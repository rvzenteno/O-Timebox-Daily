{
  "name": "timebox-daily",
  "version": "1.4.0",
  "description": "Smart daily timeboxing with multi-project tracking, sidebar dashboard, auto task rollover, and bi-directional task sync.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "esbuild test/schedulingEngine.test.ts --bundle --platform=node --format=esm --packages=external --outfile=test/dist.test.mjs && node --test test/dist.test.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },

  "keywords": [],
  "author": "Victor",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "esbuild": "0.17.3",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "moment": "^2.30.1",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
